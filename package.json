{
  "name": "pettech-bmm",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node scripts/iniciar.js",
    "android": "node scripts/iniciar.js --android",
    "ios": "node scripts/iniciar.js --ios",
    "web": "node scripts/iniciar.js --web",
    "api": "node scripts/iniciar.js --so-api",
    "typecheck": "tsc --noEmit && tsc -p server --noEmit",
    "resetar-banco": "node -e \"for (const f of ['server/dados/pettech.db','server/dados/pettech.db.tmp']) require('fs').rmSync(f,{force:true});console.log('Banco removido. Ele será recriado com os produtos iniciais no próximo npm start.')\""
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/metro-runtime": "~4.0.0",
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "cors": "^2.8.5",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.0",
    "expo-font": "~13.0.4",
    "expo-linear-gradient": "~14.0.2",
    "expo-linking": "~7.0.0",
    "expo-router": "~4.0.0",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.0",
    "express": "^4.21.2",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13",
    "sql.js": "^1.12.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.12",
    "@types/sql.js": "^1.4.9",
    "typescript": "^5.3.3"
  },
  "private": true
}
